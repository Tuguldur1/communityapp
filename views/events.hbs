<h1 class="text-4xl font-bold mb-8 text-center text-gray-800">Community Events</h1>

{{#if user}}
  <div class="text-center mb-6">
    <a href="/events/add" class="px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition">Add Event</a>
  </div>
{{/if}}

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {{#each events}}
    <div class="bg-white p-6 rounded-2xl shadow-lg hover:shadow-xl transition">
      <h2 class="text-2xl font-semibold mb-3">{{this.title}}</h2>
      <p class="text-gray-700 mb-2">{{this.description}}</p>
      <p class="text-gray-500 mb-1"><span class="font-medium">Date:</span> {{this.formattedDate}}</p>
      <p class="text-gray-500 mb-4"><span class="font-medium">Location:</span> {{this.location}}</p>

      {{#if ../user}}
        <div class="flex space-x-3">
          <a href="/events/edit/{{this._id}}" class="flex-1 text-center px-4 py-2 bg-yellow-400 text-white rounded-xl hover:bg-yellow-500 transition">Edit</a>
          <form action="/events/delete/{{this._id}}" method="POST" class="flex-1">
            <button type="submit" class="w-full px-4 py-2 bg-red-500 text-white rounded-xl hover:bg-red-600 transition">Delete</button>
          </form>
        </div>
      {{/if}}
    </div>
  {{/each}}
</div>
