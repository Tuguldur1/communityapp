<h1 class="text-4xl font-bold mb-8 text-center text-gray-800">Community Leader Voting</h1>

{{!-- Success message --}}
{{#if success_msg}}
<div class="bg-green-200 text-green-800 p-3 rounded mb-4 text-center">
  {{success_msg}}
</div>
{{/if}}

{{!-- Error message --}}
{{#if error_msg}}
<div class="bg-red-200 text-red-800 p-3 rounded mb-4 text-center">
  {{error_msg}}
</div>
{{/if}}

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {{#each users}}
    <div class="bg-white p-6 rounded-2xl shadow-lg flex flex-col justify-between hover:shadow-xl transition">
      
      <h2 class="text-2xl font-semibold mb-3">{{this.username}}</h2>

      <p class="text-gray-700 mb-4">
        Votes:
        <span class="font-medium text-lg">{{this.votes.length}}</span>
      </p>

      {{!-- Only logged-in users can vote --}}
      {{#if ../user}}
        <form action="/vote/{{this._id}}" method="POST">
          <button 
            type="submit" 
            class="w-full px-4 py-2 bg-green-500 text-white rounded-xl hover:bg-green-600 transition">
            Vote
          </button>
        </form>
      {{else}}
        <p class="text-sm text-gray-500 text-center mt-2">Login required to vote.</p>
      {{/if}}
      
    </div>
  {{/each}}
</div>
