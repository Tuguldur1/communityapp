<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <header class="bg-gray-900 text-white shadow-md">
    <div class="container mx-auto flex flex-col md:flex-row justify-between items-center p-4">
      <h1 class="text-2xl font-bold mb-2 md:mb-0">Community App</h1>
      <nav class="flex flex-col md:flex-row items-center space-y-2 md:space-y-0 md:space-x-3">
  <a href="/" class="px-3 py-1 rounded hover:bg-gray-700 transition">Home</a>
  <a href="/events" class="px-3 py-1 rounded hover:bg-gray-700 transition">Events</a>
  <a href="/leaders" class="px-3 py-1 rounded hover:bg-gray-700 transition">Leaders</a>

  {{#if user}}
    <a href="/chat" class="px-3 py-1 rounded hover:bg-gray-700 transition">Chat</a> <!-- Updated style -->
    <span class="md:ml-4 font-medium">Hello, {{user.username}}</span>
    <a href="/users/logout" class="ml-0 md:ml-3 px-3 py-1 bg-red-500 rounded hover:bg-red-600 transition">Logout</a>
  {{else}}
    <a href="/users/login" class="px-3 py-1 bg-green-500 rounded hover:bg-green-600 transition">Login</a>
    <a href="/users/register" class="px-3 py-1 bg-yellow-500 rounded hover:bg-yellow-600 transition">Register</a>
  {{/if}}
</nav>
    </div>
  </header>

  <!-- Flash messages -->
  <div class="container mx-auto mt-6">
    {{#if success_msg}}
      <div class="bg-green-100 border-l-4 border-green-500 text-green-800 p-4 mb-4 rounded shadow">{{success_msg}}</div>
    {{/if}}
    {{#if error_msg}}
      <div class="bg-red-100 border-l-4 border-red-500 text-red-800 p-4 mb-4 rounded shadow">{{error_msg}}</div>
    {{/if}}
    {{#if error}}
      <div class="bg-red-100 border-l-4 border-red-500 text-red-800 p-4 mb-4 rounded shadow">{{error}}</div>
    {{/if}}
  </div>

  <!-- Main content -->
  <main class="flex-grow container mx-auto p-6">
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white text-center p-6 mt-6">
    &copy; 2025 Community App
  </footer>

</body>
</html>
