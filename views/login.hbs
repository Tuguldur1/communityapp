<h1 class="text-4xl font-bold mb-6 text-center text-gray-800">Login</h1>

<form action="/users/login" method="POST" class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow-lg space-y-5">
  <input type="text" name="username" placeholder="Username" required 
         class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none">
  <input type="password" name="password" placeholder="Password" required 
         class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none">
  <button type="submit" class="w-full bg-blue-600 text-white font-semibold p-3 rounded-lg hover:bg-blue-700 transition">Login</button>
</form>
