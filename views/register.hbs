<h1 class="text-4xl font-bold mb-6 text-center text-gray-800">Register</h1>

<form action="/users/register" method="POST" class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow-lg space-y-5">
  <input type="text" name="username" placeholder="Username" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none">
  <input type="email" name="email" placeholder="Email" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none">
  <input type="password" name="password" placeholder="Password" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none">
  <input type="password" name="password2" placeholder="Confirm Password" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none">
  <button type="submit" class="w-full bg-green-600 text-white font-semibold p-3 rounded-lg hover:bg-green-700 transition">Register</button>
</form>
