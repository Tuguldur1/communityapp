<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Community Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Carousel slides (background gradients) */
    .slide {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1.5s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .slide.active {
      opacity: 1;
    }

    /* Gradient backgrounds for slides */
    .slide1 { background: linear-gradient(135deg, #667eea, #764ba2); }
    .slide2 { background: linear-gradient(135deg, #f7971e, #ffd200); }
    .slide3 { background: linear-gradient(135deg, #43cea2, #185a9d); }

    /* Floating decorative circles */
    .floating-circle {
      border-radius: 50%;
      opacity: 0.1;
      animation: float 6s ease-in-out infinite alternate;
    }

    @keyframes float {
      0% { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(-20px) rotate(360deg); }
    }
  </style>
</head>
<body class="font-sans bg-gray-50">

  <!-- Hero Section -->
  <section class="relative w-full h-screen overflow-hidden">
    <!-- Slides -->
    <div class="absolute inset-0">
      <div class="slide slide1 active"></div>
      <div class="slide slide2"></div>
      <div class="slide slide3"></div>
    </div>

    <!-- Gradient Overlay + Text -->
    <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center text-center text-white px-6">
      <h1 class="text-5xl md:text-6xl font-extrabold mb-4 drop-shadow-lg">Welcome to Community Hub</h1>
      <p class="text-lg md:text-xl max-w-3xl mb-8 drop-shadow-md">Connect with neighbors, join events, vote for leaders, and stay informed. Everything your community needs, in one place.</p>
      <a href="/events" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 font-semibold rounded-xl shadow-lg hover:scale-105 hover:shadow-xl transition-transform duration-300">
        <span>Explore Events</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <!-- Decorative floating circles -->
    <span class="absolute top-10 left-10 w-24 h-24 bg-blue-400 floating-circle"></span>
    <span class="absolute bottom-10 right-20 w-32 h-32 bg-purple-500 floating-circle"></span>
  </section>

  <!-- Featured Events -->
  <section class="py-20 bg-gray-100">
    <div class="container mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Upcoming Events</h2>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-3">Community Picnic</h3>
          <p class="text-gray-700 mb-2">Saturday, Dec 14 | Central Park</p>
          <p class="text-gray-600 text-sm">Join neighbors for a fun afternoon with games, food, and music!</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-3">Neighborhood Clean-Up</h3>
          <p class="text-gray-700 mb-2">Sunday, Dec 15 | Main Street</p>
          <p class="text-gray-600 text-sm">Help keep our community clean and green. All supplies provided.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-3">Holiday Charity Drive</h3>
          <p class="text-gray-700 mb-2">Dec 20-24 | Community Center</p>
          <p class="text-gray-600 text-sm">Donate gifts and essentials to families in need this holiday season.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leaders & Announcements -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Community Leaders & Announcements</h2>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="p-8 bg-gradient-to-tr from-blue-50 to-purple-50 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="font-semibold mb-3 text-gray-800">Mayor Jane Doe</h3>
          <p class="text-gray-700 text-sm">"We're committed to making our neighborhood safe and vibrant for everyone."</p>
        </div>
        <div class="p-8 bg-gradient-to-tr from-blue-50 to-purple-50 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="font-semibold mb-3 text-gray-800">Council Announcement</h3>
          <p class="text-gray-700 text-sm">Next town hall meeting: Dec 18, 6 PM at Community Hall.</p>
        </div>
        <div class="p-8 bg-gradient-to-tr from-blue-50 to-purple-50 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="font-semibold mb-3 text-gray-800">Community Volunteer</h3>
          <p class="text-gray-700 text-sm">Looking for volunteers for the local food drive. Join us to help!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Neighborhood Connections -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-8 text-gray-800">Connect with Your Neighbors</h2>
      <p class="text-gray-700 max-w-3xl mx-auto mb-12">Share news, organize small gatherings, or start a discussion. Strengthen your community one connection at a time.</p>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-2">Discussion Threads</h3>
          <p class="text-gray-600 text-sm">Talk about local topics, ask questions, and get advice from neighbors.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-2">Interest Groups</h3>
          <p class="text-gray-600 text-sm">Join groups for sports, books, hobbies, or volunteer activities.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300">
          <h3 class="text-2xl font-semibold mb-2">Local Updates</h3>
          <p class="text-gray-600 text-sm">Stay informed with neighborhood news, safety alerts, and community projects.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Carousel JS -->
  <script>
    let slideIndex = 0;
    const slides = document.querySelectorAll('.slide');

    function showSlides() {
      slides.forEach((slide) => slide.classList.remove('active'));
      slideIndex = (slideIndex + 1) % slides.length;
      slides[slideIndex].classList.add('active');
    }

    setInterval(showSlides, 5000); // Change every 5 seconds
  </script>

</body>
</html>
